APP_NAME=DonPaty
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://panaderia.example.com
APP_FORCE_HTTPS=true
TRUSTED_PROXIES=

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_DISPLAY_TIMEZONE=America/Bogota
APP_CURRENCY=COP

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=donpaty
DB_USERNAME=donpaty_app
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax
SESSION_DOMAIN=panaderia.example.com

CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local
ATTACHMENTS_DISK=local
ATTACHMENTS_MAXIMUM_SIZE_KB=10240

# Los respaldos deben salir de la instancia principal.
BACKUPS_DISK=s3
BACKUPS_DIRECTORY=donpaty/production/backups
BACKUPS_RETENTION_COUNT=30
MYSQLDUMP_BINARY=mysqldump
MYSQL_BINARY=mysql

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
